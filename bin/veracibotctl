#!/usr/bin/env bash
# Controle dos serviços do VeraciBot.
# Uso: veracibotctl {start|stop|restart|status|logs} [bot|web|all]
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
VENV="$ROOT/.venv"
LOGDIR="$ROOT/logs"
WEB_PORT="$(grep -E '^WEB_PORT=' "$ROOT/.env" 2>/dev/null | cut -d= -f2 || true)"
WEB_PORT="${WEB_PORT:-8000}"

ensure_venv() {
    if [ ! -x "$VENV/bin/python" ]; then
        echo "Criando ambiente virtual e instalando dependências..."
        python3 -m venv "$VENV"
        "$VENV/bin/pip" install -q --upgrade pip
        "$VENV/bin/pip" install -q -r "$ROOT/requirements.txt"
    fi
}

cmd_for() {
    case "$1" in
        bot) echo "$VENV/bin/python -m src.veracibot.main" ;;
        web) echo "$VENV/bin/uvicorn src.veracibot.web.app:app --host 0.0.0.0 --port $WEB_PORT" ;;
    esac
}

pidfile() { echo "$LOGDIR/$1.pid"; }
logfile() { echo "$LOGDIR/$1.log"; }

is_running() {
    [ -f "$(pidfile "$1")" ] && kill -0 "$(cat "$(pidfile "$1")")" 2>/dev/null
}

start_one() {
    local svc="$1"
    if is_running "$svc"; then
        echo "[$svc] já está rodando (PID $(cat "$(pidfile "$svc")"))."
        return 0
    fi
    if [ "$svc" = "bot" ] && [ ! -f "$ROOT/.env" ]; then
        echo "ERRO: $ROOT/.env não encontrado. Copie de .env.example e preencha as chaves."
        exit 1
    fi
    ensure_venv
    mkdir -p "$LOGDIR"
    cd "$ROOT"
    # shellcheck disable=SC2046
    nohup $(cmd_for "$svc") >> "$(logfile "$svc")" 2>&1 &
    echo $! > "$(pidfile "$svc")"
    echo "[$svc] iniciado (PID $(cat "$(pidfile "$svc")")). Log: $(logfile "$svc")"
    [ "$svc" = "web" ] && echo "[web] http://localhost:$WEB_PORT"
}

stop_one() {
    local svc="$1"
    if ! is_running "$svc"; then
        echo "[$svc] não está rodando."
        rm -f "$(pidfile "$svc")"
        return 0
    fi
    kill "$(cat "$(pidfile "$svc")")"
    rm -f "$(pidfile "$svc")"
    echo "[$svc] parado."
}

status_one() {
    if is_running "$1"; then
        echo "[$1] rodando (PID $(cat "$(pidfile "$1")"))."
    else
        echo "[$1] parado."
    fi
}

ACTION="${1:-}"
TARGET="${2:-all}"
case "$TARGET" in
    bot|web) SERVICES=("$TARGET") ;;
    all) SERVICES=(bot web) ;;
    *) echo "Serviço desconhecido: $TARGET (use bot, web ou all)"; exit 1 ;;
esac

case "$ACTION" in
    start)   for s in "${SERVICES[@]}"; do start_one "$s"; done ;;
    stop)    for s in "${SERVICES[@]}"; do stop_one "$s"; done ;;
    restart) for s in "${SERVICES[@]}"; do stop_one "$s"; done; sleep 1
             for s in "${SERVICES[@]}"; do start_one "$s"; done ;;
    status)  for s in "${SERVICES[@]}"; do status_one "$s"; done ;;
    logs)
        if [ "$TARGET" = "all" ]; then tail -f "$LOGDIR"/bot.log "$LOGDIR"/web.log
        else tail -f "$(logfile "$TARGET")"; fi ;;
    *)
        echo "Uso: $(basename "$0") {start|stop|restart|status|logs} [bot|web|all]"
        exit 1 ;;
esac
