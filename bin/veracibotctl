#!/usr/bin/env bash
# Controle do daemon VeraciBot: start | stop | restart | status | logs
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
PIDFILE="$ROOT/veracibot.pid"
LOGFILE="$ROOT/logs/veracibot.log"
VENV="$ROOT/.venv"

ensure_venv() {
    if [ ! -x "$VENV/bin/python" ]; then
        echo "Criando ambiente virtual e instalando dependências..."
        python3 -m venv "$VENV"
        "$VENV/bin/pip" install -q --upgrade pip
        "$VENV/bin/pip" install -q -r "$ROOT/requirements.txt"
    fi
}

is_running() {
    [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null
}

case "${1:-}" in
    start)
        if is_running; then
            echo "VeraciBot já está rodando (PID $(cat "$PIDFILE"))."
            exit 0
        fi
        if [ ! -f "$ROOT/.env" ]; then
            echo "ERRO: $ROOT/.env não encontrado. Copie de .env.example e preencha as chaves."
            exit 1
        fi
        ensure_venv
        mkdir -p "$ROOT/logs"
        cd "$ROOT"
        nohup "$VENV/bin/python" -m src.veracibot.main >> "$LOGFILE" 2>&1 &
        echo $! > "$PIDFILE"
        echo "VeraciBot iniciado (PID $(cat "$PIDFILE")). Logs: $LOGFILE"
        ;;
    stop)
        if ! is_running; then
            echo "VeraciBot não está rodando."
            rm -f "$PIDFILE"
            exit 0
        fi
        kill "$(cat "$PIDFILE")"
        rm -f "$PIDFILE"
        echo "VeraciBot parado."
        ;;
    restart)
        "$0" stop
        sleep 1
        "$0" start
        ;;
    status)
        if is_running; then
            echo "VeraciBot rodando (PID $(cat "$PIDFILE"))."
        else
            echo "VeraciBot parado."
        fi
        ;;
    logs)
        tail -f "$LOGFILE"
        ;;
    *)
        echo "Uso: $(basename "$0") {start|stop|restart|status|logs}"
        exit 1
        ;;
esac
