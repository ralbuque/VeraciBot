# X API v2 (plano Basic) - https://developer.x.com
X_BEARER_TOKEN=
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# Bot
BOT_HANDLE=veracibot
POLL_INTERVAL_SECONDS=120
DB_PATH=veracibot.db
# true = posta o veredito como reply; false = só registra no banco
POST_REPLIES=true
# limite de tweets lidos por thread (controle do orçamento de leitura)
MAX_THREAD_TWEETS=50
# habilita busca na web para fact-checking (custo extra na API Anthropic)
JUDGE_WEB_SEARCH=true

# Modo convite: true = só membros convidados podem abrir casos
INVITE_ONLY=false

# Quorum mínimo de votos para reformar sentença em recurso (use 2 em testes)
APPEAL_QUORUM=5

# Promoção "Em Busca da Verdade" (o site também lê PROMO_ENABLED)
PROMO_ENABLED=false
PROMO_START=2026-08-16T00:00:00-03:00
PROMO_END=2026-08-23T00:00:00-03:00

# Tamanho máximo do reply. 280 = padrão; conta Premium pode usar mais (ex. 4000)
# Se o X recusar o texto longo, o bot reposta automaticamente a versão de 280.
MAX_REPLY_LEN=280

# Site (veraci.bot)
WEB_PORT=8000
SITE_URL=https://veraci.bot
# segredo das sessões (gere um valor longo e aleatório)
WEB_SECRET=
# admin do site (criado automaticamente no primeiro start do web)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# reports do site viram issues no GitHub (token fine-grained com Issues: write)
GITHUB_TOKEN=
GITHUB_REPO=ralbuque/veracibot
